# Normalize line endings in the repository.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.json    text
*.yml     text
*.yaml    text
*.md      text

# Keep Docker and shell entrypoints LF even on Windows checkouts.
*.sh      text eol=lf
Dockerfile text eol=lf

# Binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.pdf     binary
