# Longevia Backend - production environment example (VPS only).
# Never commit the real .env.production. Fill secrets on the VPS and keep a copy
# in the team password manager.

# Runtime
ASPNETCORE_ENVIRONMENT=Production
APP_TIMEZONE=Asia/Ho_Chi_Minh
Database__AutoMigrate=false

# PostgreSQL
POSTGRES_USER=longevia
POSTGRES_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me
IDENTITY_DB=identity_db
DIET_DB=diet_db
PROGRESS_DB=progress_db
KNOWLEDGE_DB=recommendation_db

# RabbitMQ
RABBITMQ_USER=longevia
RABBITMQ_PASSWORD=change-me

# JWT (ES256)
# Identity only: JWT__SIGNING_PRIVATE_KEY. Diet and Progress use the public key.
JWT__ISSUER=longevia
JWT__AUDIENCE=longevia-clients
JWT__KEY_ID=longevia-prod-01
JWT__SIGNING_PRIVATE_KEY=
JWT__SIGNING_PUBLIC_KEY=
JWT__PREVIOUS_KEY_ID=
JWT__PREVIOUS_PUBLIC_KEY=

# Internal service auth
SERVICE__TOKEN=change-me

# Google AI
GOOGLE_AI__API_KEY=
GOOGLE_AI__CHAT_MODEL=gemini-3.5-flash-lite

# RAG
RAG__TOP_K=8
RAG__MAX_CANDIDATES=50
RAG__EMBEDDING_MODEL=gemini-embedding-001
RAG__EMBEDDING_DIM=768
RAG__REQUIRE_VERIFIED=false
RAG__MIN_CITATION_SIMILARITY=0.75
RAG__CHUNK_TOKENS=1000
RAG__CHUNK_OVERLAP=150

# Recommendation
RECOMMENDATION__GRPC_PORT=50051
RECOMMENDATION__HTTP_PORT=8080
RECOMMENDATION__DEADLINE_SECONDS=30
RECOMMENDATION__PLAN_DEADLINE_SECONDS=90

# Diet budgets
DIET_RECOMMENDATION_DEADLINE_MS=20000
DIET_MEAL_PLAN_DEADLINE_MS=90000

# Digest scheduler
DIGEST_ENABLED=true
DIGEST_RUN_ON_START=false

# Email (Brevo SMTP Relay)
SMTP__HOST=smtp-relay.brevo.com
SMTP__PORT=587
SMTP__USE_SSL=true
SMTP__USER=
SMTP__PASSWORD=
SMTP__SENDER_EMAIL=no-reply@mail.hycat.online
FRONTEND_BASE_URL=https://longevia.hycat.online

# Observability
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Deploy / TLS
DOMAIN=api.longevia.hycat.online
TLS_DIR=/opt/longevia-tls
ACME_EMAIL=hycat.support@gmail.com
DNS_PROVIDER=vercel
GATEWAY_HTTP_PORT=8084
GATEWAY_HTTPS_PORT=8446

# Optional: only needed while GHCR packages are private.
# GHCR_USERNAME=
# GHCR_READ_TOKEN=
