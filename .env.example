# ---------------------------------------------------------------------------
# Longevia Backend - example environment file.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# IMPORTANT: every comment in this file MUST be written in English.
# ---------------------------------------------------------------------------

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL - one server, one database per owning service.
POSTGRES_USER=longevia
POSTGRES_PASSWORD=change-me
# Password for the per-service login roles created by the init script.
POSTGRES_APP_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
IDENTITY_DB=identity_db
DIET_DB=diet_db
PROGRESS_DB=progress_db

# Connection strings (used by `dotnet run` outside Docker).
# In Docker these are injected per service by docker-compose.
ConnectionStrings__Identity=Host=localhost;Port=5432;Database=identity_db;Username=identity_user;Password=change-me
ConnectionStrings__Diet=Host=localhost;Port=5432;Database=diet_db;Username=diet_user;Password=change-me
ConnectionStrings__Progress=Host=localhost;Port=5432;Database=progress_db;Username=progress_user;Password=change-me

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT
JWT__ISSUER=longevia
JWT__AUDIENCE=longevia-clients
JWT__SIGNING_KEY=change-me-development-only

# Nginx API gateway (host port mapped to container 80)
GATEWAY_PORT=8080

# External providers
CLOUDINARY__CLOUD_NAME=
CLOUDINARY__API_KEY=
CLOUDINARY__API_SECRET=
GOOGLE_AI__API_KEY=
BREVO__API_KEY=
BREVO__SENDER_EMAIL=no-reply@longevia.local
