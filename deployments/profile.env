# Longevia BE - machine-readable deployment profile (non-secret values only).
# Human-readable rationale and status per value: docs/deployment/DECISIONS.md
# Rule: never put secrets in this file. Fill every empty value before the
# phase 0 gate; empty means "still Undecided" in DECISIONS.md.

APP_NAME=longevia
APP_OWNER=fa26-prn232-group2
APP_REPO=github.com/fa26-prn232-group2/longevia-be
SERVICES=identity,diet,progress,recommendation,worker

STACK_identity=dotnet
STACK_diet=dotnet
STACK_progress=dotnet
STACK_recommendation=dotnet
STACK_worker=dotnet

ENVIRONMENTS=production

# production - single environment (dev decision 2026-11-13).
PRODUCTION_DOMAIN=api.longevia.hycat.online
PRODUCTION_HTTP_PORT=8084
PRODUCTION_HTTPS_PORT=8446
PRODUCTION_PATH=/opt/longevia-production
PRODUCTION_COMPOSE=deployments/docker-compose.production.yml
PRODUCTION_ENV_FILE=.env.production
PRODUCTION_DEPLOY_FILE=.env.production.deploy
PRODUCTION_TRIGGER=tag:v*
PRODUCTION_HEALTH_URL=https://api.longevia.hycat.online:8446/health
PRODUCTION_ACME_EMAIL=hycat.support@gmail.com
PRODUCTION_FRONTEND_ORIGIN=
PRODUCTION_DNS_TOKEN_PATH=/opt/longevia-secrets/production/dns.token

# Email: production uses Brevo SMTP Relay; Mailpit is local only.
MAIL_PROVIDER=brevo-smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_STARTTLS=true
MAIL_SENDER=no-reply@hycat.online

# Shared infrastructure.
IMAGE_PREFIX=ghcr.io/fa26-prn232-group2/longevia
TLS_MODEL=lego-dns01
DNS_PROVIDER=vercel
PROXY=nginx
DB_ENGINE=postgres
DB_VERSION=17

# The production env file lives on the VPS, not in Git and not in GitHub.
SECRET_MODEL=vps-env-file
SECRET_PATH=/opt/longevia-secrets/production
BACKUP_PATH=/opt/longevia-backups
TLS_DIR=/opt/longevia-tls
