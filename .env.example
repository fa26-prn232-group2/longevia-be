# ---------------------------------------------------------------------------
# Longevia Backend - example environment file.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# IMPORTANT: every comment in this file MUST be written in English.
# ---------------------------------------------------------------------------

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL - one server, one database per owning service.
POSTGRES_USER=longevia
POSTGRES_PASSWORD=change-me
# Password for the per-service login roles created by the init script.
POSTGRES_APP_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
IDENTITY_DB=identity_db
DIET_DB=diet_db
PROGRESS_DB=progress_db
# Knowledge store of the Recommendation service (corpus only, never user data).
KNOWLEDGE_DB=recommendation_db

# Connection strings (used by `dotnet run` outside Docker).
# In Docker these are injected per service by docker-compose.
ConnectionStrings__Identity=Host=localhost;Port=5432;Database=identity_db;Username=identity_user;Password=change-me
ConnectionStrings__Diet=Host=localhost;Port=5432;Database=diet_db;Username=diet_user;Password=change-me
ConnectionStrings__Progress=Host=localhost;Port=5432;Database=progress_db;Username=progress_user;Password=change-me
ConnectionStrings__Recommendation=Host=localhost;Port=5432;Database=recommendation_db;Username=recommendation_user;Password=change-me

# Recommendation RAG - retrieval and corpus ingestion settings.
# Number of snippets returned to the caller (max 20).
RAG__TOP_K=8
# Number of candidates per retrieval branch before the RRF merge.
RAG__MAX_CANDIDATES=50
# Embedding model used for the corpus (runtime service and offline pipeline).
RAG__EMBEDDING_MODEL=gemini-embedding-001
# Embedding dimensions; must match the vector(n) column of kb.chunk.
RAG__EMBEDDING_DIM=768
# When true, only chunks verified against the printed book are used.
RAG__REQUIRE_VERIFIED=false
# Minimum similarity (0..1) for a citation to count as matching its source chunk.
RAG__MIN_CITATION_SIMILARITY=0.75
# Chunk size and overlap, in tokens, used when the corpus is loaded.
RAG__CHUNK_TOKENS=1000
RAG__CHUNK_OVERLAP=150

# Recommendation service listeners - neither port is published to the host.
# gRPC port (HTTP/2 cleartext) used by the services calling recommendation.
RECOMMENDATION__GRPC_PORT=50051
# HTTP/1.1 port serving the /health endpoint for probes.
RECOMMENDATION__HTTP_PORT=8080
# Server-side gRPC deadline in seconds (valid range 5..120, default 30).
# It must stay above the real text-generation latency of the provider (Gemini
# chat measured up to ~16s); a smaller value causes DEADLINE_EXCEEDED answers.
RECOMMENDATION__DEADLINE_SECONDS=30
# Server-side gRPC deadline for the two plan RPCs (GenerateMealPlan and
# GenerateWorkoutPlan) in seconds (valid range 5..120, default 90).
# The five existing RPCs keep RECOMMENDATION__DEADLINE_SECONDS.
RECOMMENDATION__PLAN_DEADLINE_SECONDS=90

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT - ES256 (see docs/decisions/001-authn-authz-architecture.md).
# Only Identity holds the private key; Diet and Progress hold only the public key.
# Values are base64 of the PEM on a single line, because an env var cannot carry
# newlines. Generate a local keypair with: make jwt-keys
JWT__ISSUER=longevia
JWT__AUDIENCE=longevia-clients
# Key id advertised in the token header `kid`.
JWT__KEY_ID=longevia-dev-01
# Identity ONLY - never inject this into Diet or Progress, never commit it.
# Base64 of a PKCS#8 PEM ("-----BEGIN PRIVATE KEY-----").
JWT__SIGNING_PRIVATE_KEY=
# Diet and Progress - public key only.
# Base64 of an SPKI PEM ("-----BEGIN PUBLIC KEY-----").
JWT__SIGNING_PUBLIC_KEY=
# Rotation only - keep the previous public key until every token signed with it
# has expired, then clear these two.
JWT__PREVIOUS_KEY_ID=
JWT__PREVIOUS_PUBLIC_KEY=

# Nginx API gateway (host port mapped to container 80)
GATEWAY_PORT=8080

# External providers
CLOUDINARY__CLOUD_NAME=
CLOUDINARY__API_KEY=
CLOUDINARY__API_SECRET=
GOOGLE_AI__API_KEY=
# Gemini model used for grounded answers (the embedding model is set via RAG__).
GOOGLE_AI__CHAT_MODEL=gemini-3.5-flash-lite
BREVO__API_KEY=
BREVO__SENDER_EMAIL=no-reply@longevia.local
